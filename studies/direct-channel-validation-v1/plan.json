{
  "schema_version": 1,
  "framework_version": "2.3.0",
  "purpose": "Validate direct HTTP multi-turn collection, not a reminder effect or model ranking",
  "independent_seeds": 1,
  "families": ["diagnosis", "cascade"],
  "profiles": ["standard"],
  "domains": ["incident"],
  "conditions": ["open"],
  "replicates": 1,
  "wall_seconds": 900,
  "agents": [
    {"name": "gpt-5.6-sol", "kind": "responses", "model": "gpt-5.6-sol", "endpoint_env": "DIRECT_ENDPOINT", "api_key_env": "DIRECT_KEY", "headers_env": "DIRECT_HEADERS", "timeout_seconds": 180, "options": {"reasoning_effort": "high"}},
    {"name": "custom/z-ai/glm-5.3", "kind": "responses", "model": "custom/z-ai/glm-5.3", "endpoint_env": "DIRECT_ENDPOINT", "api_key_env": "DIRECT_KEY", "headers_env": "DIRECT_HEADERS", "timeout_seconds": 180, "options": {"reasoning_effort": "high"}}
  ],
  "stopping_rule": "Exactly four planned episodes, one attempt each; preserve every failure and do not add or replace samples",
  "transport": {
    "interface": "Existing authenticated loopback router, /v1/responses",
    "headers": {"x-codex-router-exact-route": "1"},
    "tools": [],
    "tool_choice": "none",
    "store": false,
    "stream": true,
    "native_agent_runtime": false,
    "benchmark_retries": 0
  }
}

 F={x['event_id']:x for x in ce}\\n      R={x['request_id']:x for x in orq}; S={x['request_id']:x for x in crq}\\n      assert (len(O),len(C),len(E),len(F),len(R),len(S))==(36,51,79,109,79,109)\\n      assert len(E.keys()&F.keys())==20 and len(E.keys()-F.keys())==59 and len(F.keys()-E.keys())==89\\n      assert E.keys()==R.keys() and F.keys()==S.keys()\\n      # Common accepted records must be byte/logically identical.\\n      for eid in E.keys()&F.keys():\\n        assert comparable(E[eid],('id',))==comparable(F[eid],('id',)), ('shared event mismatch',eid)\\n        assert comparable(R[eid])==comparable(S[eid]), ('shared request mismatch',eid)\\n        assert E[eid]['id']==F[eid]['id'], ('shared source id mismatch',eid)\\n      # Every order's branch states must form a revision chain, never competing same-revision values.\\n      for ref in O.keys()&C.keys():\\n        if O[ref]['revision']==C[ref]['revision']:\\n          assert comparable(O[ref],('id',))==comparable(C[ref],('id',)), ('same rev order conflict',ref)\\n      # Preserve alpha source IDs so existing carrier keys/receipts remain authoritative.\\n      assert sorted(x['id'] for x in oe)==list(range(1,80))\\n      current_only=sorted((F[eid] for eid in F.keys()-E.keys()),key=lambda x:x['id'])\\n      mapping=[]\\n      with dst.cursor() as q:\\n        for x in current_only:\\n          temp=-1000000-x['id']\\n          q.execute('update outbox set id=%s where event_id=%s::uuid returning id',(temp,x['event_id']))\\n          assert q.rowcount==1\\n        for new_id,x in enumerate(current_only,start=80):\\n          temp=-1000000-x['id']\\n          q.execute('update outbox set id=%s where id=%s returning event_id::text',(new_id,temp))\\n          got=q.fetchone()[0]; assert got==x['event_id']\\n          mapping.append({'event_id':x['event_id'],'reference':x['reference'],'old_id':x['id'],'new_id':new_id})\\n        # Restore all alpha-only accepted outbox rows at their original IDs.\\n        for x in sorted((E[eid] for eid in E.keys()-F.keys()),key=lambda x:x['id']):\\n          q.execute('insert into outbox(id,event_id,reference,revision,kind,payload,created_at) values(%s,%s::uuid,%s,%s,%s,%s,%s)',\\n                    (x['id'],x['event_id'],x['reference'],x['revision'],x['kind'],Json(x['payload']),x['created_at']))\\n        # Restore exact idempotency request bodies and acknowledged responses.\\n        for x in sorted((R[eid] for eid in R.keys()-S.keys()),key=lambda x:x['accepted_at']):\\n          q.execute('insert into requests(request_id,body,response,accepted_at) values(%s::uuid,%s,%s,%s)',\\n                    (x['request_id'],Json(x['body']),Json(x['response']),x['accepted_at']))\\n        # Restore missing orders with fresh internal IDs; advance shared orders to highest accepted revision.\\n        next_order_id=max(x['id'] for x in co)\\n        order_mapping=[]\\n        for x in sorted((O[ref] for ref in O.keys()-C.keys()),key=lambda x:x['id']):\\n          next_order_id+=1\\n          q.execute('insert into orders(id,reference,revision,customer,address,items,status,updated_at) values(%s,%s,%s,%s,%s,%s,%s,%s)',\\n                    (next_order_id,x['reference'],x['revision'],x['customer'],x['address'],Json(x['items']),x['status'],x['updated_at']))\\n          order_mapping.append({'reference':x['reference'],'recovered_id':x['id'],'merged_id':next_order_id})\\n        advanced=[]\\n        for ref in sorted(O.keys()&C.keys()):\\n          a,b=O[ref],C[ref]\\n          if a['revision']>b['revision']:\\n            q.execute('update orders set revision=%s,customer=%s,address=%s,items=%s,status=%s,updated_at=%s where reference=%s',\\n                      (a['revision'],a['customer'],a['address'],Json(a['items']),a['status'],a['updated_at'],ref))\\n            assert q.rowcount==1\\n            advanced.append({'reference':ref,'from_revision':b['revision'],'to_revision':a['revision'],'source':'recovered-alpha'})\\n        q.execute(\\\"select setval(pg_get_serial_sequence('orders','id'),(select max(id) from orders),true)\\\")\\n        q.execute(\\\"select setval(pg_get_serial_sequence('outbox','id'),(select max(id) from outbox),true)\\\")\\n      # In-transaction postconditions.\\n      vo=rows(dst,'select id,reference,revision,customer,address,items,status,updated_at from orders order by id')\\n      ve=rows(dst,'select id,event_id::text event_id,reference,revision,kind,payload,created_at from outbox order by id')\\n      vr=rows(dst,'select request_id::text request_id,body,response,accepted_at from requests order by accepted_at')\\n      assert len(vo)==75 and len(ve)==168 and len(vr)==168\\n      assert sorted(x['id'] for x in ve)==list(range(1,169))\\n      assert {x['event_id'] for x in ve}==E.keys()|F.keys()\\n      assert {x['request_id'] for x in vr}==R.keys()|S.keys()\\n      V={x['reference']:x for x in vo}\\n      for ref in O.keys()|C.keys():\\n        src=O[ref] if ref not in C or O[ref]['revision']>C[ref]['revision'] else C[ref]\\n        assert comparable(V[ref],('id',))==comparable(src,('id',)), ('merged order mismatch',ref)\\n      audit={'outbox_current_remap':mapping,'recovered_order_id_map':order_mapping,'shared_orders_advanced':advanced,\\n             'post_counts':{'orders':len(vo),'outbox':len(ve),'requests':len(vr)}}\\n      json.dump(audit,open('/var/backups/incident/merge-audit.json','w'),indent=2,sort_keys=True)\\n    print(json.dumps(audit,indent=2,sort_keys=True))\\nfinally:\\n    old.close(); dst.close()\\nPY\\nchmod 700 /tmp/merge_branches.py\\npython3 /tmp/merge_branches.py > /var/backups/incident/merge-output.txt\\ncat /var/backups/incident/merge-output.txt | tail -80\\npsql -h 127.0.0.1 -p 5433 -U postgres -d commerce -X -P pager=off <<'SQL'\\nselect 'orders' t,count(*) n,min(id),max(id),min(updated_at),max(updated_at) from orders union all select 'outbox',count(*),min(id),max(id),min(created_at),max(created_at) from outbox union all select 'requests',count(*),null,null,min(accepted_at),max(accepted_at) from requests;\\nselect status,count(*) from orders group by status order by status;\\nselect kind,count(*) from outbox group by kind order by kind;\\nSQL\"}"

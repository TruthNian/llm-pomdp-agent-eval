              "arguments": "{\"target\":\"cat > /tmp/final_reconcile.py <<'PY'\\nimport json,sqlite3,psycopg2,urllib.request,time,re\\nfrom collections import Counter,defaultdict\\nDB=dict(host='127.0.0.1',port=5433,user='postgres',dbname='commerce')\\nlast=None\\nfor attempt in range(20):\\n c=psycopg2.connect(**DB); q=c.cursor()\\n q.execute('select id,event_id::text,reference,revision,kind,payload,extract(epoch from created_at) from outbox')\\n out=[dict(zip(('id','event_id','reference','revision','kind','payload','created_epoch'),x)) for x in q]\\n q.execute('select request_id::text,body,response,extract(epoch from accepted_at) from requests')\\n req=[dict(zip(('request_id','body','response','accepted_epoch'),x)) for x in q]\\n q.execute('select id,reference,revision,customer,address,items,status from orders')\\n orders=[dict(zip(('id','reference','revision','customer','address','items','status'),x)) for x in q]\\n c.close()\\n with urllib.request.urlopen('http://127.0.0.1:8099/bookings',timeout=5) as r: car=json.load(r)['bookings']\\n E={x['event_id']:x for x in out}; R={x['request_id']:x for x in req}; O={x['reference']:x for x in orders}; C={x['client_reference']:x for x in car}\\n releases={e:x for e,x in E.items() if x['kind']=='release'}\\n if set(C)==set(releases) and len(car)==len(releases): break\\n last=(len(E),len(releases),len(car),len(set(releases)-set(C)),len(set(C)-set(releases)))\\n time.sleep(.5)\\nelse: raise AssertionError(('carrier did not converge',last))\\n# Database history and command semantics.\\nassert len(E)==len(out)==len(R)==len(req)\\nassert len(O)==len(orders)\\nassert set(E)==set(R)\\nbyref=defaultdict(list)\\nfor e,x in E.items():\\n b=R[e]['body']; assert b['request_id']==e and b['reference']==x['reference'] and b['revision']==x['revision'] and b['kind']==x['kind']\\n assert R[e]['response']['event_id']==e\\n p=x['payload']; assert p['reference']==x['reference'] and p['revision']==x['revision']\\n if x['kind'] in ('draft','amend'):\\n  for f in ('customer','address','items'): assert b[f]==p[f]\\n byref[x['reference']].append(x)\\nfor ref,xs in byref.items():\\n assert ref in O\\n xs.sort(key=lambda x:x['revision']); rev=[x['revision'] for x in xs]\\n assert rev==list(range(rev[0],rev[-1]+1)) and xs[0]['kind']=='draft' and rev[0]>=1,(ref,rev)\\n final=xs[-1]['payload']; now=O[ref]\\n for f in ('reference','revision','customer','address','items','status'): assert final[f]==now[f],(ref,f,final[f],now[f])\\n assert now['status'] in ('released','cancelled')\\n# Carrier exact one-to-one and exact contents.\\nfor e,x in releases.items():\\n b=C[e]; p=x['payload']\\n assert b['idempotency_key']=='outbox:'+str(x['id'])\\n assert b['order_reference']==x['reference'] and O[x['reference']]['status']=='released'\\n for f in ('customer','address','items'): assert b[f]==p[f]\\nfor field in ('booking_id','idempotency_key','client_reference','order_reference'):\\n assert all(n==1 for n in Counter(x[field] for x in car).values()),field\\n# Local durable receipt ledger exactly mirrors carrier and current source IDs.\\nledger=sqlite3.connect('/var/lib/commerce-dispatch.sqlite')\\nL=list(ledger.execute('select source_id,event_id,reference,booking_id from receipts'))\\nexpected={(x['id'],e,x['reference'],C[e]['booking_id']) for e,x in releases.items()}\\nassert len(L)==len(expected) and set(L)==expected\\n# Every 201 acceptance visible in logs is retained; 200s are retries of retained IDs.\\npat=re.compile(r'^\\\\S+ \\\\S+ INFO command (\\\\S+) (\\\\S+) (\\\\S+) -> (\\\\d+)$')\\nlogs=[]\\nfor line in open('/var/log/commerce/api.log'):\\n m=pat.match(line)\\n if m: logs.append((m[1],m[2],m[3],int(m[4])))\\naccepted={e for e,r,k,s in logs if s==201}\\nretries={e for e,r,k,s in logs if s==200}\\nassert accepted==set(R),(len(accepted),len(R),accepted-set(R),set(R)-accepted)\\nassert retries<=set(R)\\n# Normal post-recovery release latency.\\nlat=[]\\nfor e,x in releases.items():\\n if R[e]['accepted_epoch'] >= 1790159589: # 2026-09-23 10:33:09 UTC\\n  lat.append(C[e]['accepted_at']-R[e]['accepted_epoch'])\\nassert lat and max(lat)<60, max(lat)\\nreport={\\n 'checked_at':time.time(),'orders':len(O),'accepted_requests':len(R),'outbox_events':len(E),\\n 'released':len(releases),'cancelled':sum(o['status']=='cancelled' for o in O.values()),\\n 'carrier_bookings':len(car),'receipts':len(L),'unique_201_log_acceptances':len(accepted),\\n 'idempotent_retries_seen':len(retries),'post_recovery_release_latency_seconds_max':max(lat),\\n 'post_recovery_release_latency_seconds_min':min(lat),'post_recovery_releases_checked':len(lat)\\n}\\njson.dump(report,open('/var/backups/incident/final-reconciliation.json','w'),indent=2,sort_keys=True)\\nprint(json.dumps(report,indent=2,sort_keys=True))\\nPY\\npython3 /tmp/final_reconcile.py\"}"

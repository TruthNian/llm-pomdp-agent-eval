ka/libs/plexus-utils-3.5.1.jar:/opt/kafka/libs/protobuf-java-3.25.5.jar:/opt/kafka/libs/re2j-1.7.jar:/opt/kafka/libs/rocksdbjni-9.7.3.jar:/opt/kafka/libs/scala-library-2.13.15.jar:/opt/kafka/libs/scala-logging_2.13-3.9.5.jar:/opt/kafka/libs/scala-reflect-2.13.15.jar:/opt/kafka/libs/slf4j-api-1.7.36.jar:/opt/kafka/libs/snakeyaml-2.2.jar:/opt/kafka/libs/snappy-java-1.1.10.5.jar:/opt/kafka/libs/swagger-annotations-2.2.25.jar:/opt/kafka/libs/trogdor-4.0.0.jar:/opt/kafka/libs/zstd-jni-1.5.6-6.jar org.apache.kafka.connect.cli.ConnectDistributed /etc/commerce/connect.properties\n=== git ===\n",

n chain validation\nq.execute('select reference,revision,kind,event_id::text,payload from outbox order by created_at,id')\nfrom collections import defaultdict\nby=defaultdict(list)\nfor r,v,k,e,p in q:by[r].append((v,k,e,p))\nfor r,x in by.items():\n rev=[a[0] for a in x]; assert len(rev)==len(set(rev)),(r,rev); assert rev==sorted(rev),(r,rev)\n assert x[0][1]=='draft',(r,x)\n assert x[-1][3]['revision']==orders[r][1],(r,x[-1],orders[r])\n assert x[-1][3]['status']==orders[r][0],(r,x[-1],orders[r])\nprint('all',len(by),'order revision chains and final states verified')\nPY\n# verify physical standby has replayed merge\npsql -h 127.0.0.1 -p 5432 -U postgres -d commerce -X -P pager=off -c \"select pg_is_in_recovery(),pg_last_wal_receive_lsn(),pg_last_wal_replay_lsn(),(select count(*) from outbox) outbox,(select count(*) from requests) requests,(select count(*) from orders) orders;\""

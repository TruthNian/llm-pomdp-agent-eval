ur];json.dump(orders,open('/var/backups/incident/db-orders.json','w'),indent=2,sort_keys=True,default=str)\n# flatten after\nke=[]\nfor m in msgs:\n v=m['value']; a=v.get('after') if v else None\n if a: ke.append({**a,'_partition':m['partition'],'_offset':m['offset']})\nK={str(x['event_id']):x for x in ke}; D={str(x['event_id']):x for x in db}\nprint('kafka after',len(ke),'unique ids',len(K),'DB',len(D),'intersection',len(K.keys()&D.keys()),'K-not-D',len(K.keys()-D.keys()),'D-not-K',len(D.keys()-K.keys()))\nprint('K-not-D')\nfor x in ke:\n if str(x['event_id']) not in D: print(json.dumps(x,sort_keys=True))\nprint('D-not-K summary',Counter(x['kind'] for x in db if str(x['event_id']) not in K), 'first/last ids', [x['id'] for x in db if str(x['event_id']) not in K][:5], [x['id'] for x in db if str(x['event_id']) not in K][-5:])\n# discrepancies same event\nbad=[]\nfor eid in K.keys()&D.keys():\n k,d=K[eid],D[eid]\n for f in ('reference','revision','kind','payload'):\n  kv=k[f]; dv=d[f]\n  if f=='payload' and isinstance(kv,str): kv=json.loads(kv)\n  if kv!=dv: bad.append((eid,f,kv,dv))\nprint('same event discrepancies',len(bad));print(*bad[:10],sep='\\n')\n# parse API\npat=re.compile(r'^(\\d\\S* \\S+?) INFO command (\\S+) (\\S+) (\\S+) -> (\\d+)$')\nlogs=[]\nfor n,l in enumerate(open('/var/log/commerce/api.log'),1):\n m=pat.match(l.rstrip())\n if m: logs.append({'line':n,'ts':m[1],'event_id':m[2],'reference':m[3],'kind':m[4],'status':int(m[5])})\nA={x['event_id']:x for x in logs if x['status'] in (200,201)}\nprint('log command records',len(logs),Counter(x['status'] for x in logs),'accepted uniq',len(A))\nprint('accepted log-not-DB',len(A.keys()-D.keys()))\nfor eid in A.keys()-D.keys(): print(A[eid])\nprint('DB-not-log',len(D.keys()-A.keys()))\nprint('accepted by seconds',Counter(x['ts'][:19] for x in A.values()))\n# carrier\ncar=json.load(open('/tmp/bookings.json'))['bookings']; C={x['client_reference']:x for x in car}\nprint('carrier',len(C),'carrier event not DB',C.keys()-D.keys(),'carrier event not K',C.keys()-K.keys())\nprint('DB releases',sum(x['kind']=='release' for x in db),'K releases',sum(x['kind']=='release' for x in ke),'undispatched DB release event IDs',len([x for x in db if x['kind']=='release' and str(x['event_id']) not in C]))\n# IDs overlap with different events (danger)\nbyidk={int(x['id']):x for x in ke}; byidd={int(x['id']):x for x in db}\ncoll=[]\nfor i in byidk.keys()&byidd.keys():\n if str(byidk[i]['event_id'])!=str(byidd[i]['event_id']):coll.append((i,byidk[i]['event_id'],byidd[i]['event_id'],byidk[i]['reference'],byidd[i]['reference']))\nprint('source id collisions K vs D',len(coll));print(*coll,sep='\\n')\nPY\npython3 /tmp/analyze_incident.py"
